{
  "name": "seven-desk",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "desktop:dev": "npm run dev --workspace @seven/desktop",
    "desktop:build": "npm run build --workspace @seven/desktop",
    "desktop:check": "npm run check --workspace @seven/desktop",
    "installers:hash": "node scripts/hash-installers.mjs",
    "installers:verify": "node scripts/hash-installers.mjs --verify",
    "tauri:dev": "npm run tauri:dev --workspace @seven/desktop",
    "tauri:build": "npm run tauri:build --workspace @seven/desktop",
    "smoke:server": "node scripts/smoke-local.mjs",
    "dev:clean": "node scripts/clean-local.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:session": "node scripts/smoke-session.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
