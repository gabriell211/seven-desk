{$SEVEN_DOMAIN} {
    tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem

    @outside_vpn {
        not remote_ip {$SEVEN_VPN_CIDR}
    }
    respond @outside_vpn "VPN necessária" 403

    request_body {
        max_size 3MB
    }
    header {
        X-Content-Type-Options "nosniff"
        Cache-Control "no-store"
    }
    reverse_proxy 127.0.0.1:43821
}
