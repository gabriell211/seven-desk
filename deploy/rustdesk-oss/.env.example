# Servidor OWNED/self-hosted. A imagem 1.1.16 é publicada para linux/amd64 e linux/arm64.
# Atualize a versão somente após validar o protocolo e as alterações upstream.
RUSTDESK_IMAGE=rustdesk/rustdesk-server:1.1.16
# Endereço público acessível aos clientes, incluindo a porta do relay.
RUSTDESK_RELAY_HOST=desk.example.com:21117
