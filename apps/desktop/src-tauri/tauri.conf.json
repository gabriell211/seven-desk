{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seven Desk",
  "version": "0.1.0",
  "identifier": "dev.seven.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seven Desk",
        "width": 1180,
        "height": 760,
        "minWidth": 700,
        "minHeight": 560,
        "backgroundColor": "#10141d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:43821"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "Seven Desk - acesso remoto seguro",
    "category": "Utility",
    "windows": { "nsis": { "displayLanguageSelector": false } }
  }
}
