{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seven Desk",
  "version": "0.1.0",
  "identifier": "dev.seven.desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seven Desk",
        "width": 1180,
        "height": 760,
        "minWidth": 700,
        "minHeight": 560,
        "backgroundColor": "#10141d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:43821"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "publisher": "Seven Desk Project",
    "homepage": "https://github.com/gabriell211/seven-desk",
    "shortDescription": "Seven Desk - acesso remoto experimental",
    "longDescription": "Aplicativo em desenvolvimento para acesso remoto com autorização explícita do dispositivo atendido.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
